NODE_ENV=production
PORT=30006
JWT_SECRET=your-secure-jwt-secret-here
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/hr_dashboard?retryWrites=true&w=majority
MONGO_POOL_SIZE=200
ADMIN_EMAIL=admin@edufyitech.in
ADMIN_PASSWORD=YourAdminPassword
HR_EMAIL=hr@edufyitech.in
HR_PASSWORD=YourHRPassword
DEFAULT_EMPLOYEE_PASSWORD=Password@123
TRUST_PROXY=true

# SMTP Workspace Mail Configuration (Gmail / Google Workspace)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false

# App Passwords generated from Google Account (Security -> 2-Step Verification -> App Passwords)
ADMIN_EMAIL_PASS=your_admin_gmail_app_password
HR_EMAIL_PASS=your_hr_gmail_app_password

# IT Support Workspace Email & App Password (Dedicated IT channel)
IT_EMAIL=itsupport@edufyitech.in
IT_EMAIL_PASS=your_it_support_gmail_app_password

# General / Facilities Workspace Email (Admin gateway)
HELPDESK_EMAIL=admin@edufyitech.in
HELPDESK_EMAIL_PASS=your_admin_gmail_app_password

# Public portal URL for hyperlinks in email notifications
APP_PUBLIC_URL=https://edufyione.edufyitech.in
